\ ->
  let bind_i = (-12345 :: Integer)
  let bind_w = (0 :: String)
  let bind_mb = (\mArg_e -> mArg_e # mArg_e)
                # (\functionalArg_f ->
                    (\a b c ->
                      (\bind_ib ->
                        case 
                          (EqualsInteger # b # (0 :: Integer))
                          [ AppendString
                            # (
                                a
                                # (QuotientInteger # b # (10 :: Integer))
                                # (RemainderInteger # b # (10 :: Integer))
                              )
                            # bind_ib
                          , bind_ib
                          ]
                      )
                      # (
                          (\d ->
                            case d
                              [ bind_w
                              , (1 :: String)
                              , (2 :: String)
                              , (3 :: String)
                              , (4 :: String)
                              , (5 :: String)
                              , (6 :: String)
                              , (7 :: String)
                              , (8 :: String)
                              , (9 :: String)
                              ]
                          )
                          # c
                        )
                    )
                    # (functionalArg_f # functionalArg_f)
                  )
  let bind_tb = SubtractInteger # (0 :: Integer) # bind_i
  in case 
       (LessThanEqualsInteger # bind_i # (-1 :: Integer))
       [ case 
           (EqualsInteger # bind_i # (0 :: Integer))
           [ bind_mb
             # (QuotientInteger # bind_i # (10 :: Integer))
             # (RemainderInteger # bind_i # (10 :: Integer))
           , bind_w
           ]
       , AppendString
         # (- :: String)
         # (case 
             (EqualsInteger # bind_tb # (0 :: Integer))
             [ bind_mb
               # (QuotientInteger # bind_tb # (10 :: Integer))
               # (RemainderInteger # bind_tb # (10 :: Integer))
             , bind_w
             ]
           )
       ]