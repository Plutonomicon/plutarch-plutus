\ ->
  let bind_h = (-12345 :: Integer)
  let bind_v = ("0" :: String)
  let bind_lb = (\mArg_e -> mArg_e # mArg_e)
                # (\a b c ->
                    (\bind_hb ->
                      case 
                        (EqualsInteger # b # (0 :: Integer))
                        [ AppendString
                          # (
                              a
                              # a
                              # (QuotientInteger # b # (10 :: Integer))
                              # (RemainderInteger # b # (10 :: Integer))
                            )
                          # bind_hb
                        , bind_hb
                        ]
                    )
                    # (
                        (\d ->
                          case d
                            [ bind_v
                            , ("1" :: String)
                            , ("2" :: String)
                            , ("3" :: String)
                            , ("4" :: String)
                            , ("5" :: String)
                            , ("6" :: String)
                            , ("7" :: String)
                            , ("8" :: String)
                            , ("9" :: String)
                            ]
                        )
                        # c
                      )
                  )
  let bind_sb = SubtractInteger # (0 :: Integer) # bind_h
  in case 
       (LessThanEqualsInteger # bind_h # (-1 :: Integer))
       [ case 
           (EqualsInteger # bind_h # (0 :: Integer))
           [ bind_lb
             # (QuotientInteger # bind_h # (10 :: Integer))
             # (RemainderInteger # bind_h # (10 :: Integer))
           , bind_v
           ]
       , AppendString
         # ("-" :: String)
         # (case 
             (EqualsInteger # bind_sb # (0 :: Integer))
             [ bind_lb
               # (QuotientInteger # bind_sb # (10 :: Integer))
               # (RemainderInteger # bind_sb # (10 :: Integer))
             , bind_v
             ]
           )
       ]