\ ->
  let bind_j = ("cat goes nya" :: Bytestring)
  let bind_k = LengthOfByteString # bind_j
  let bind_ib = \e ->
                  case e
                    [ ("0" :: String)
                    , ("1" :: String)
                    , ("2" :: String)
                    , ("3" :: String)
                    , ("4" :: String)
                    , ("5" :: String)
                    , ("6" :: String)
                    , ("7" :: String)
                    , ("8" :: String)
                    , ("9" :: String)
                    , ("A" :: String)
                    , ("B" :: String)
                    , ("C" :: String)
                    , ("D" :: String)
                    , ("E" :: String)
                    , ("F" :: String)
                    ]
  in case 
       (EqualsInteger # bind_k # (0 :: Integer))
       [ AppendString
         # ("[" :: String)
         # (
             AppendString
             # (case 
                 (constr 0
                   [ bind_j
                   , SubtractInteger # bind_k # (1 :: Integer)
                   , (0 :: Integer)
                   ]
                 )
                 [ (\mArg_f -> mArg_f # mArg_f)
                   # (\a b c d ->
                       (\bind_lb ->
                         (\bind_tb ->
                           case 
                             (EqualsInteger # c # d)
                             [ AppendString
                               # bind_tb
                               # (
                                   AppendString
                                   # (", " :: String)
                                   # (case 
                                       (constr 0
                                         [b, c, AddInteger # d # (1 :: Integer)]
                                       )
                                       [a # a]
                                     )
                                 )
                             , bind_tb
                             ]
                         )
                         # (
                             AppendString
                             # ("0x" :: String)
                             # (
                                 AppendString
                                 # (bind_ib
                                     # (
                                         QuotientInteger
                                         # bind_lb
                                         # (16 :: Integer)
                                       )
                                   )
                                 # (bind_ib
                                     # (
                                         RemainderInteger
                                         # bind_lb
                                         # (16 :: Integer)
                                       )
                                   )
                               )
                           )
                       )
                       # (IndexByteString # b # d)
                     )
                 ]
               )
             # ("]" :: String)
           )
       , ("[]" :: String)
       ]