\a b ->
  case 
    (EqualsInteger # a # (0 :: Integer))
    [ (\c ->
        (\mArg_d -> mArg_d # mArg_d)
        # (\e f g ->
            case 
              (EqualsInteger # g # (0 :: Integer))
              [ (\h -> e # e # h # (ModInteger # f # h)) # g
              , (\i ->
                  case 
                    (LessThanEqualsInteger # i # (0 :: Integer))
                    [i, (\j -> SubtractInteger # (0 :: Integer) # j) # i]
                )
                # f
              ]
          )
        # c
        # b
      )
      # a
    , b
    ]