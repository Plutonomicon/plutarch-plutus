\a b ->
  case 
    (EqualsInteger # a # (0 :: Integer))
    [ (\mArg_c -> case (constr 0 [mArg_c, a, b]) [mArg_c])
      # (\functionalArg_d ->
          (\e f g ->
            case 
              (EqualsInteger # g # (0 :: Integer))
              [ e # g # (ModInteger # f # g)
              , case 
                  (LessThanEqualsInteger # f # (0 :: Integer))
                  [f, SubtractInteger # (0 :: Integer) # f]
              ]
          )
          # (functionalArg_d # functionalArg_d)
        )
    , b
    ]