\jp kp ->
  case 
    (EqualsInteger # jp # (0 :: Integer))
    [ (\mArg_lp -> case (constr 0 [mArg_lp, jp, kp]) [mArg_lp])
      # (\functionalArg_mp ->
          (\np op pp ->
            case 
              (EqualsInteger # pp # (0 :: Integer))
              [ np # pp # (ModInteger # op # pp)
              , case 
                  (LessThanEqualsInteger # op # (0 :: Integer))
                  [op, SubtractInteger # (0 :: Integer) # op]
              ]
          )
          # (functionalArg_mp # functionalArg_mp)
        )
    , kp
    ]