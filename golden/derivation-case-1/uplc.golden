\a b ->
  let bind_l = \unused_e -> (False :: Bool)
  let bind_o = \unused_e unused_e -> (False :: Bool)
  in case a
       [ \c -> case b [\d -> EqualsInteger # c # d, bind_l, bind_o]
       , \h -> case b [bind_l, \j -> EqualsInteger # h # j, bind_o]
       , \m n ->
           case b
             [ bind_l
             , bind_l
             , \q r ->
                 case 
                   (EqualsInteger # n # r)
                   [(False :: Bool), EqualsInteger # m # q]
             ]
       ]