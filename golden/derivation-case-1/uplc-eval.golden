\a b ->
  let bind_c = \unused_p unused_q -> (False :: Bool)
  in case a
       [ \d ->
           case b
             [\e -> EqualsInteger # d # e, \unused_f -> (False :: Bool), bind_c]
       , \g ->
           case b
             [\unused_h -> (False :: Bool), \i -> EqualsInteger # g # i, bind_c]
       , \j k ->
           case b
             [ \unused_l -> (False :: Bool)
             , \unused_m -> (False :: Bool)
             , \n o ->
                 case 
                   (EqualsInteger # k # o)
                   [(False :: Bool), EqualsInteger # j # n]
             ]
       ]