\ ->
  let bind_x = constr 0 []
  in (\mArg_d -> mArg_d # mArg_d)
     # (\a b c ->
         case b
           [ case c [(True :: Bool), \unused_e unused_e -> (False :: Bool)]
           , \f g ->
               case c
                 [ (False :: Bool)
                 , \h i ->
                     case 
                       (a # a # g # i)
                       [(False :: Bool), EqualsInteger # f # h]
                 ]
           ]
       )
     # bind_x
     # (constr 1
         [ (3 :: Integer)
         , constr 1 [(2 :: Integer), constr 1 [(1 :: Integer), bind_x]]
         ]
       )