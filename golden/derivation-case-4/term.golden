(
  fix (\a_self b c ->
        case b
          [ case c [True :: Bool, \_ _ -> False :: Bool]
          , \d e ->
              case c
                [ False :: Bool
                , \f g ->
                    case (a_self # e # g) [False :: Bool, EqualsInteger # d # f]
                ]
          ]
      )
)
# (constr 0 [])
# (constr 1
    [ 3 :: Integer
    , constr 1 [2 :: Integer, constr 1 [1 :: Integer, constr 0 []]]
    ]
  )