\a b ->
  case 
    (EqualsInteger # (0 :: Integer) # b)
    [ (\c ->
        (\mArg_d -> mArg_d # mArg_d)
        # (\e f ->
            case 
              (EqualsInteger # f # (1 :: Integer))
              [ (\bind_g ->
                  (\bind_h ->
                    case 
                      (RemainderInteger # f # (2 :: Integer))
                      [bind_h, MultiplyInteger # bind_h # c]
                  )
                  # (MultiplyInteger # bind_g # bind_g)
                )
                # (e # e # (QuotientInteger # f # (2 :: Integer)))
              , c
              ]
          )
      )
      # a
      # b
    , (1 :: Integer)
    ]