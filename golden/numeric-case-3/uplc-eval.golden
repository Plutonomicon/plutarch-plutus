\a b ->
  case 
    (EqualsInteger # (0 :: Integer) # b)
    [ (\mArg_c -> mArg_c # mArg_c # b)
      # (\functionalArg_d ->
          (\e f ->
            (\bind_g ->
              (\bind_h ->
                case 
                  (EqualsInteger # f # (1 :: Integer))
                  [ case 
                      (RemainderInteger # f # (2 :: Integer))
                      [bind_h, MultiplyInteger # bind_h # a]
                  , a
                  ]
              )
              # (MultiplyInteger # bind_g # bind_g)
            )
            # (e # (QuotientInteger # f # (2 :: Integer)))
          )
          # (functionalArg_d # functionalArg_d)
        )
    , (1 :: Integer)
    ]