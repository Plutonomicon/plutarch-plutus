\a b ->
  case 
    (EqualsInteger # (0 :: Integer) # b)
    [ (\c ->
        (\mArg_f -> mArg_f # mArg_f)
        # (\functionalArg_g ->
            (\d e ->
              case 
                (EqualsInteger # e # (1 :: Integer))
                [ (\bind_t ->
                    case 
                      (RemainderInteger # e # (2 :: Integer))
                      [ bind_u
                      , (\bind_u -> MultiplyInteger # bind_u # c)
                        # (MultiplyInteger # bind_t # bind_t)
                      ]
                  )
                  # (d # (QuotientInteger # e # (2 :: Integer)))
                , c
                ]
            )
            # (functionalArg_g # functionalArg_g)
          )
      )
      # a
      # b
    , (1 :: Integer)
    ]