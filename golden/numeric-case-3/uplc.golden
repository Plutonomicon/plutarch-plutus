\rp sp ->
  case 
    (EqualsInteger # (0 :: Integer) # sp)
    [ (\mArg_tp -> mArg_tp # mArg_tp # sp)
      # (\functionalArg_up ->
          (\vp wp ->
            (\bind_xp ->
              (\bind_yp ->
                case 
                  (EqualsInteger # wp # (1 :: Integer))
                  [ case 
                      (RemainderInteger # wp # (2 :: Integer))
                      [bind_yp, MultiplyInteger # bind_yp # rp]
                  , rp
                  ]
              )
              # (MultiplyInteger # bind_xp # bind_xp)
            )
            # (vp # (QuotientInteger # wp # (2 :: Integer)))
          )
          # (functionalArg_up # functionalArg_up)
        )
    , (1 :: Integer)
    ]