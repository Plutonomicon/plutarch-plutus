\a b ->
  case 
    (EqualsInteger # (0 :: Integer) # b)
    [ (\c ->
        (\mArg_f -> mArg_f # mArg_f)
        # (\d e ->
            case 
              (EqualsInteger # e # (1 :: Integer))
              [ (\bind_s ->
                  (\bind_t ->
                    case 
                      (RemainderInteger # e # (2 :: Integer))
                      [bind_t, MultiplyInteger # bind_t # c]
                  )
                  # (MultiplyInteger # bind_s # bind_s)
                )
                # (d # d # (QuotientInteger # e # (2 :: Integer)))
              , c
              ]
          )
      )
      # a
      # b
    , (1 :: Integer)
    ]