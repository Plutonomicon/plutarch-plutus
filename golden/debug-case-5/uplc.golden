\ ->
  let bind_eb = ("0" :: String)
  let bind_ub = (\mArg_l -> mArg_l # mArg_l)
                # (\h i j ->
                    (\bind_qb ->
                      case 
                        (EqualsInteger # i # (0 :: Integer))
                        [ AppendString
                          # (
                              h
                              # h
                              # (QuotientInteger # i # (10 :: Integer))
                              # (RemainderInteger # i # (10 :: Integer))
                            )
                          # bind_qb
                        , bind_qb
                        ]
                    )
                    # (
                        (\k ->
                          case k
                            [ bind_eb
                            , ("1" :: String)
                            , ("2" :: String)
                            , ("3" :: String)
                            , ("4" :: String)
                            , ("5" :: String)
                            , ("6" :: String)
                            , ("7" :: String)
                            , ("8" :: String)
                            , ("9" :: String)
                            ]
                        )
                        # j
                      )
                  )
  in case ([1, 2, 3, 4] :: [Integer])
       [ \a b ->
           AppendString
           # ("[" :: String)
           # (
               AppendString
               # (
                   (\mArg_m -> mArg_m # mArg_m)
                   # (\c d e ->
                       (\bind_bc ->
                         (\bind_ic ->
                           case e
                             [ \f g ->
                                 AppendString
                                 # bind_ic
                                 # (
                                     AppendString
                                     # (", " :: String)
                                     # (c # c # f # g)
                                   )
                             , bind_ic
                             ]
                         )
                         # (case 
                             (LessThanEqualsInteger # d # (-1 :: Integer))
                             [ case 
                                 (EqualsInteger # d # (0 :: Integer))
                                 [ bind_ub
                                   # (QuotientInteger # d # (10 :: Integer))
                                   # (RemainderInteger # d # (10 :: Integer))
                                 , bind_eb
                                 ]
                             , AppendString
                               # ("-" :: String)
                               # (case 
                                   (EqualsInteger # bind_bc # (0 :: Integer))
                                   [ bind_ub
                                     # (
                                         QuotientInteger
                                         # bind_bc
                                         # (10 :: Integer)
                                       )
                                     # (
                                         RemainderInteger
                                         # bind_bc
                                         # (10 :: Integer)
                                       )
                                   , bind_eb
                                   ]
                                 )
                             ]
                           )
                       )
                       # (SubtractInteger # (0 :: Integer) # d)
                     )
                   # a
                   # b
                 )
               # ("]" :: String)
             )
       , ("[]" :: String)
       ]