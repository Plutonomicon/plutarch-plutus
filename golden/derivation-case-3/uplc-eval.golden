\a b ->
  let bind_c = \unused_o -> (False :: Bool)
  let bind_d = \unused_m unused_n -> (False :: Bool)
  in case 
       (constr 0
         [ \e ->
             case (constr 0 [\f -> EqualsInteger # e # f, bind_c, bind_d]) [b]
         , \g ->
             case (constr 0 [bind_c, \h -> EqualsInteger # g # h, bind_d]) [b]
         , \i j ->
             case 
               (constr 0
                 [ bind_c
                 , bind_c
                 , \k l ->
                     case 
                       (EqualsInteger # i # k)
                       [(False :: Bool), EqualsInteger # j # l]
                 ]
               )
               [b]
         ]
       )
       [a]