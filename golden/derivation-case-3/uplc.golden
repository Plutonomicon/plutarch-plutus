\a b ->
  let bind_l = \unused_e -> (False :: Bool)
  let bind_o = \unused_e unused_e -> (False :: Bool)
  in case 
       (constr 0
         [ \c ->
             case (constr 0 [\d -> EqualsInteger # c # d, bind_l, bind_o]) [b]
         , \h ->
             case (constr 0 [bind_l, \j -> EqualsInteger # h # j, bind_o]) [b]
         , \m n ->
             case 
               (constr 0
                 [ bind_l
                 , bind_l
                 , \q r ->
                     case 
                       (EqualsInteger # n # r)
                       [(False :: Bool), EqualsInteger # m # q]
                 ]
               )
               [b]
         ]
       )
       [a]