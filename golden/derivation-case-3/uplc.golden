\mx nx ->
  let bind_ox = \unused_by unused_cy -> (False :: Bool)
  in case 
       (constr 0
         [ \px ->
             case 
               (constr 0
                 [ \qx -> EqualsInteger # px # qx
                 , \unused_rx -> (False :: Bool)
                 , bind_ox
                 ]
               )
               [nx]
         , \sx ->
             case 
               (constr 0
                 [ \unused_tx -> (False :: Bool)
                 , \ux -> EqualsInteger # sx # ux
                 , bind_ox
                 ]
               )
               [nx]
         , \vx wx ->
             case 
               (constr 0
                 [ \unused_xx -> (False :: Bool)
                 , \unused_yx -> (False :: Bool)
                 , \zx ay ->
                     case 
                       (EqualsInteger # wx # ay)
                       [(False :: Bool), EqualsInteger # vx # zx]
                 ]
               )
               [nx]
         ]
       )
       [mx]