\ ->
  let bind_v = \a ->
                 case a
                   [ ("0" :: String)
                   , ("1" :: String)
                   , ("2" :: String)
                   , ("3" :: String)
                   , ("4" :: String)
                   , ("5" :: String)
                   , ("6" :: String)
                   , ("7" :: String)
                   , ("8" :: String)
                   , ("9" :: String)
                   , ("A" :: String)
                   , ("B" :: String)
                   , ("C" :: String)
                   , ("D" :: String)
                   , ("E" :: String)
                   , ("F" :: String)
                   ]
  in AppendString
     # (
         AppendString
         # ("0x" :: String)
         # (bind_v # (QuotientInteger # (31 :: Integer) # (16 :: Integer)))
       )
     # (bind_v # (RemainderInteger # (31 :: Integer) # (16 :: Integer)))